<!-- Placeholder for Fleck 5600SXT Brine Tank -->
<svg width="600" height="600" viewBox="0 0 600 600" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="600" height="600" fill="#334155"/>
  
  <!-- Brine Tank View -->
  <g transform="translate(300, 300)">
    <!-- Tank Body -->
    <rect x="-120" y="-200" width="240" height="350" rx="10" fill="#1e293b" stroke="#475569" stroke-width="3"/>
    
    <!-- Tank Interior -->
    <rect x="-110" y="-190" width="220" height="330" rx="8" fill="#0f172a"/>
    
    <!-- Salt Crystals -->
    <g opacity="0.8">
      <polygon points="-80,-50 -70,-60 -60,-50 -70,-40" fill="#e0e7ff"/>
      <polygon points="-40,-70 -30,-80 -20,-70 -30,-60" fill="#e0e7ff"/>
      <polygon points="0,-60 10,-70 20,-60 10,-50" fill="#e0e7ff"/>
      <polygon points="40,-80 50,-90 60,-80 50,-70" fill="#e0e7ff"/>
      <polygon points="-60,-30 -50,-40 -40,-30 -50,-20" fill="#e0e7ff"/>
      <polygon points="-20,-40 -10,-50 0,-40 -10,-30" fill="#e0e7ff"/>
      <polygon points="20,-30 30,-40 40,-30 30,-20" fill="#e0e7ff"/>
      <polygon points="60,-50 70,-60 80,-50 70,-40" fill="#e0e7ff"/>
    </g>
    
    <!-- Salt Level -->
    <rect x="-100" y="0" width="200" height="140" rx="5" fill="#e0e7ff" opacity="0.3"/>
    
    <!-- Brine Well -->
    <rect x="-15" y="-180" width="30" height="320" rx="15" fill="#475569" stroke="#64748b" stroke-width="2"/>
    
    <!-- Safety Float -->
    <circle cx="0" cy="-100" r="20" fill="#ef4444" stroke="#dc2626" stroke-width="2"/>
    <rect x="-2" y="-100" width="4" height="80" fill="#64748b"/>
    
    <!-- Water Level -->
    <rect x="-100" y="100" width="200" height="40" rx="5" fill="#0891b2" opacity="0.5"/>
    
    <!-- Level Indicators -->
    <line x1="-120" y1="0" x2="-105" y2="0" stroke="#64748b" stroke-width="2"/>
    <line x1="-120" y1="50" x2="-105" y2="50" stroke="#64748b" stroke-width="2"/>
    <line x1="-120" y1="100" x2="-105" y2="100" stroke="#64748b" stroke-width="2"/>
    
    <text x="-140" y="5" text-anchor="end" fill="white" font-size="12">FULL</text>
    <text x="-140" y="55" text-anchor="end" fill="white" font-size="12">HALF</text>
    <text x="-140" y="105" text-anchor="end" fill="white" font-size="12">LOW</text>
  </g>
  
  <text x="300" y="500" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="20" font-weight="bold">
    Brine Tank Assembly
  </text>
  <text x="300" y="530" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="14" opacity="0.8">
    14" × 14" × 35" with Safety Float
  </text>
</svg>