<!-- Note: This is a placeholder. Replace with actual product image -->
<svg width="600" height="600" viewBox="0 0 600 600" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="600" height="600" fill="#0e7490"/>
  
  <!-- Background gradient -->
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0891b2;stop-opacity:0.2" />
      <stop offset="100%" style="stop-color:#06b6d4;stop-opacity:0.2" />
    </linearGradient>
  </defs>
  <rect width="600" height="600" fill="url(#bgGrad)"/>
  
  <!-- Water Softener Tank -->
  <g transform="translate(300, 300)">
    <!-- Main Tank Body -->
    <rect x="-60" y="-180" width="120" height="300" rx="10" fill="#1e293b" stroke="#334155" stroke-width="2"/>
    
    <!-- Control Head -->
    <rect x="-70" y="-200" width="140" height="40" rx="5" fill="#334155" stroke="#475569" stroke-width="2"/>
    
    <!-- Digital Display -->
    <rect x="-50" y="-190" width="100" height="20" rx="2" fill="#0f172a"/>
    <text x="0" y="-175" text-anchor="middle" fill="#22d3ee" font-family="monospace" font-size="12">5600 SXT</text>
    
    <!-- Resin Level Indicator -->
    <rect x="-50" y="-150" width="100" height="200" rx="5" fill="#0891b2" opacity="0.3"/>
    <rect x="-50" y="-50" width="100" height="100" rx="5" fill="#0891b2" opacity="0.6"/>
    
    <!-- Connection Pipes -->
    <rect x="-80" y="-180" width="20" height="8" fill="#64748b"/>
    <rect x="60" y="-180" width="20" height="8" fill="#64748b"/>
    
    <!-- Brine Tank -->
    <rect x="90" y="-100" width="80" height="220" rx="8" fill="#1e293b" stroke="#334155" stroke-width="2"/>
    <rect x="100" y="-80" width="60" height="180" rx="4" fill="#f0f9ff" opacity="0.1"/>
    
    <!-- Salt Level -->
    <rect x="100" y="20" width="60" height="80" rx="4" fill="#e0e7ff" opacity="0.3"/>
    
    <!-- Base -->
    <rect x="-80" y="120" width="250" height="10" rx="2" fill="#0f172a"/>
  </g>
  
  <!-- Labels -->
  <text x="300" y="480" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="24" font-weight="bold">
    Fleck 5600SXT
  </text>
  <text x="300" y="510" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="16" opacity="0.8">
    48,000 Grain Capacity
  </text>
  <text x="300" y="535" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="14" opacity="0.6">
    Digital Meter Control
  </text>
</svg>